<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.github.hmislk</groupId>
  <artifactId>lims-middleware-libraries</artifactId>
  <version>1.1.4</version>
  <name>lims-middleware-libraries</name>
  <properties>
    <exec.mainClass>org.carecode.lims.lims.middleware.automation.LimsMiddlewareAutomation</exec.mainClass>
    <maven.compiler.source>11</maven.compiler.source>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.target>11</maven.compiler.target>
  </properties>
</project>
